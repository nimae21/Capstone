# Application
APP_NAME=Achilles
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-achilles-domain.example

# Production logging
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# PostgreSQL (Railway production database or a local PostgreSQL instance)
DB_CONNECTION=pgsql
DB_HOST=your-private-postgres-host
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Sessions, cache, and queues use the application database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Transactional email (required for verification, invitations, and resets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="orders@your-achilles-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# PayMongo checkout and webhook verification
PAYMONGO_SECRET_KEY=your_secret_here
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here
PAYMONGO_WEBHOOK_TOLERANCE=300

# Private recommendation API (Railway internal URL in production)
RECOMMENDATION_SERVICE_URL=http://recommendation-service.railway.internal:5000
RECOMMENDATION_SERVICE_KEY=your_secret_here

# Browser/API security. Capacitor's local origins are allowed in config/cors.php.
# Browser origins allowed to call /api. The Capacitor app (https://localhost,
# http://localhost, capacitor://localhost, ionic://localhost) is always allowed
# on top of this list and needs no entry here.
CORS_ALLOWED_ORIGINS=https://your-achilles-domain.example
TRUSTED_HOSTS=your-achilles-domain.example,your-app.up.railway.app
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=achilles_

# Supabase S3-compatible product image storage
SUPABASE_STORAGE_KEY=your_key_here
SUPABASE_STORAGE_SECRET=your_secret_here
SUPABASE_STORAGE_REGION=your_region_here
SUPABASE_STORAGE_BUCKET=your_bucket_name
SUPABASE_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public/your_bucket_name

# Firebase Cloud Messaging (optional; enable only after configuring one credential source)
MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Preferred on Railway/containers: the entire Firebase service-account JSON in
# one secret variable. Leave FIREBASE_PROJECT_ID empty to use the ID in the JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative: absolute path to a service-account JSON file outside public/.
# Used only when FIREBASE_SERVICE_ACCOUNT_JSON is empty.
GOOGLE_APPLICATION_CREDENTIALS=

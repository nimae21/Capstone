# Application
APP_NAME=Achilles
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-achilles-domain.example

# Production logging
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# PostgreSQL (Railway production database or a local PostgreSQL instance)
DB_CONNECTION=pgsql
DB_HOST=your-private-postgres-host
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Local fallback: keep database drivers and run php artisan queue:work.
# Production: use the Redis block below for shared sessions, cache, locks,
# throttles, recommendation versions, and the background queue.
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_LIMITER=database
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
BACKGROUND_QUEUE=background
QUEUE_JOB_TRIES=5
QUEUE_JOB_BACKOFF=10,30,60,300
QUEUE_JOB_UNIQUE_FOR=600
ACTIVITY_JOB_TIMEOUT=30
NOTIFICATION_JOB_TIMEOUT=45
PUSH_JOB_TIMEOUT=60
BACKGROUND_RECONCILE_BATCH=100
QUEUE_HEARTBEAT_TTL=300
QUEUE_FAILED_RETENTION_HOURS=168

# Railway Redis production example. Add one Redis service, reference its
# private REDIS_URL in every Laravel web/worker/scheduler service, then set:
# REDIS_CLIENT=predis
# REDIS_URL=${{Redis.REDIS_URL}}
# CACHE_STORE=redis
# CACHE_LIMITER=redis_rate_limit
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# QUEUE_CONNECTION=redis
# REDIS_QUEUE_CONNECTION=default
# REDIS_CACHE_CONNECTION=cache
# REDIS_RATE_LIMIT_CONNECTION=rate_limit
# REDIS_CACHE_LOCK_CONNECTION=lock
# Logical databases are configurable. Prefixes also isolate data if the
# provider exposes only database zero.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_RATE_LIMIT_DB=3
REDIS_LOCK_DB=4
REDIS_QUEUE_PREFIX=queue:
REDIS_CACHE_PREFIX=cache:
REDIS_SESSION_PREFIX=session:
REDIS_RATE_LIMIT_PREFIX=rate-limit:
REDIS_LOCK_PREFIX=lock:
REDIS_QUEUE=background
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# Transactional email (required for verification, invitations, and resets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="orders@your-achilles-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# PayMongo checkout and webhook verification
PAYMONGO_SECRET_KEY=your_secret_here
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here
PAYMONGO_WEBHOOK_TOLERANCE=300

# Private recommendation API (Railway internal URL in production)
RECOMMENDATION_SERVICE_URL=http://recommendation-service.railway.internal:5000
RECOMMENDATION_SERVICE_KEY=your_secret_here
RECOMMENDATION_CONNECT_TIMEOUT=1
RECOMMENDATION_TIMEOUT=2
RECOMMENDATION_CACHE_MINUTES=10
ACTIVITY_AGGREGATION_MINUTES=60
# Zero disables deletion. Set only after approving an operational retention period.
ACTIVITY_RETENTION_DAYS=0
ACTIVITY_PRUNE_BATCH=1000

# Browser/API security. Capacitor's local origins are allowed in config/cors.php.
# Browser origins allowed to call /api. The Capacitor app (https://localhost,
# http://localhost, capacitor://localhost, ionic://localhost) is always allowed
# on top of this list and needs no entry here.
CORS_ALLOWED_ORIGINS=https://your-achilles-domain.example
TRUSTED_HOSTS=your-achilles-domain.example,your-app.up.railway.app
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=achilles_

# Supabase S3-compatible product image storage
SUPABASE_STORAGE_KEY=your_key_here
SUPABASE_STORAGE_SECRET=your_secret_here
SUPABASE_STORAGE_REGION=your_region_here
SUPABASE_STORAGE_BUCKET=your_bucket_name
SUPABASE_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public/your_bucket_name

# Firebase Cloud Messaging (optional; enable only after configuring one credential source)
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_AUTO_DISPATCH=true
FIREBASE_PROJECT_ID=
# Preferred on Railway/containers: the entire Firebase service-account JSON in
# one secret variable. Leave FIREBASE_PROJECT_ID empty to use the ID in the JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative: absolute path to a service-account JSON file outside public/.
# Used only when FIREBASE_SERVICE_ACCOUNT_JSON is empty.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated deployment ingress proxy IPs/CIDRs. Empty trusts no proxy.
# Populate from verified infrastructure configuration; do not use '*'.
TRUSTED_PROXIES=

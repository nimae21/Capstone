APP_NAME=Achilles
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-achilles-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=your-private-postgres-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your_database_user
DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@your-achilles-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_TOLERANCE=300

RECOMMENDATION_SERVICE_URL=http://recommendation-service.railway.internal:5000
RECOMMENDATION_SERVICE_KEY=

# Browser origins allowed to call /api. The Capacitor app (https://localhost,
# http://localhost, capacitor://localhost, ionic://localhost) is always allowed
# on top of this list and needs no entry here.
CORS_ALLOWED_ORIGINS=https://your-achilles-domain.example
TRUSTED_HOSTS=your-achilles-domain.example,your-app.up.railway.app

SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=achilles_

SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin Android push notifications; keep disabled until credentials are configured.
MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path outside the public directory to the server service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=